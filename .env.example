# Provider selection: nim or gemini
LLM_PROVIDER=nim

# NVIDIA NIM configuration
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT=60
NIM_MAX_TOKENS=2048
NIM_TEMPERATURE=0.7
NIM_TOP_P=0.95
NIM_REQUESTS_PER_MINUTE=100
NIM_CLASSIFIER_MODEL=meta/llama-3.1-70b-instruct
NIM_ANALYZER_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Optional fallback to Gemini
ENABLE_FALLBACK=true
GOOGLE_API_KEY=
GEMINI_CLASSIFIER_MODEL=gemini-2.0-flash-exp
GEMINI_ANALYZER_MODEL=gemini-2.0-pro-exp

# Optional distributed sessions
ENABLE_SESSION_PERSISTENCE=false
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379
