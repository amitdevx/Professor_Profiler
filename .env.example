# ==============================================================================
# PROFESSOR PROFILER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to exactly `.env` (do not commit `.env` to git).
# 2. Fill in the required API keys below.
# 3. Adjust model names and limits according to your access tiers.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMARY PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Set which LLM provider to use as the primary engine. (Options: nim, gemini)
LLM_PROVIDER=nim

# ------------------------------------------------------------------------------
# NVIDIA NIM CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Get your API key from: https://build.nvidia.com/
NIM_API_KEY=your_nvidia_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Models used for specific agent roles:
# Taxonomist uses the classifier model, Strategist/Trend Spotter use the analyzer.
NIM_CLASSIFIER_MODEL=meta/llama-3.1-70b-instruct
NIM_ANALYZER_MODEL=meta/llama-3.3-70b-instruct

# Limits and Performance Parameters
NIM_TIMEOUT=120
NIM_MAX_TOKENS=2048
NIM_TEMPERATURE=0.7
NIM_TOP_P=0.95
NIM_REQUESTS_PER_MINUTE=100

# ------------------------------------------------------------------------------
# GOOGLE GEMINI CONFIGURATION (OPTIONAL FALLBACK)
# ------------------------------------------------------------------------------
# The system can automatically failover to Gemini if NIM hits rate limits.
# Get your API key from: https://aistudio.google.com/
ENABLE_FALLBACK=true
GOOGLE_API_KEY=your_google_gemini_key_here

# Gemini models used for agent roles:
GEMINI_CLASSIFIER_MODEL=gemini-2.0-flash-exp
GEMINI_ANALYZER_MODEL=gemini-2.0-pro-exp

# ------------------------------------------------------------------------------
# SYSTEM INFRASTRUCTURE (ADVANCED)
# ------------------------------------------------------------------------------
# Enable if running across multiple containers and you need distributed memory
ENABLE_SESSION_PERSISTENCE=false
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379
